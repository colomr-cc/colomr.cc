{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Badges colomr.cc",
  "description": "Estructura que esperan las plantillas de providers.html para data/badges.json y data/anthropic_badges.json",
  "type": "array",
  "minItems": 1,
  "maxItems": 6,
  "items": {
    "type": "object",
    "required": ["titulo", "img", "fecha", "url", "desc", "desc_en"],
    "additionalProperties": false,
    "properties": {
      "titulo": {
        "type": "string",
        "minLength": 1
      },
      "img": {
        "type": "string",
        "minLength": 1,
        "description": "URL absoluta (CDN) o ruta local bajo /images/"
      },
      "fecha": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "desc": {
        "type": "string",
        "minLength": 1
      },
      "desc_en": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
